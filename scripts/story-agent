#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  ./story-agent/scripts/story-agent init [target-directory]

Examples:
  ./story-agent/scripts/story-agent init .
  ./story-agent/scripts/story-agent init ../my-repo
EOF
}

command_name="${1:-}"
if [[ -z "${command_name}" ]]; then
  usage
  exit 1
fi

case "${command_name}" in
  init)
    shift
    "${SCRIPT_DIR}/story-agent-init.sh" "$@"
    ;;
  *)
    usage
    exit 1
    ;;
esac
