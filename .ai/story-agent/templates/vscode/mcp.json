{
    "servers": {
        "jira": {
            "command": "uvx",
            "args": [
                "mcp-atlassian"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        "figma": {
            "url": "https://mcp.figma.com/mcp"
        },
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "envFile": "${workspaceFolder}/.env"
        }
    }
}