{
  // Story-agent MCP wiring. Jira + Figma are active. GitHub (for fetching linked
  // PRs as context) is commented out below — uncomment to enable. Use
  // Fine-Grained PATs/tokens, read-only, single-scope. Set env vars in your
  // shell or .env (gitignored) before launching VS Code.
  "servers": {
    // Jira via mcp-atlassian (Python, runs through uvx). Requires `uv` installed.
    // Token: create at https://id.atlassian.com/manage-profile/security/api-tokens
    "jira": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    // Figma Dev Mode MCP. Token scopes: file_content:read, file_dev_resources:read. Single team.
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "type": "http"
    }
    // -----------------------------------------------------------------
    // OPTIONAL: GitHub MCP for fetching linked PRs as enrichment context.
    // When enabled, story-agent will detect PR links in the story / comments and pull
    // diff summaries, review states, and merge status into story.md > "Linked PRs".
    // Fine-grained PAT scopes: Pull requests (read), Contents (read). Single repo or org.
    // To enable: delete each leading "// " on the 8 lines below.
    // -----------------------------------------------------------------
    //,
    //"github": {
    //  "command": "npx",
    //  "args": [
    //    "@modelcontextprotocol/server-github"
    //   ],
    //  "envFile": "${workspaceFolder}/.env"
    //}
    //  GitHub Issues as the tracker: declare it in project-overview.md Tooling;
    //  the same `github` MCP block above serves both PR enrichment and tracker fetch.
    // -----------------------------------------------------------------
    // OTHER TRACKERS (only needed if you replace Jira). Reference snippets:
    //
    //   "azure-devops": {
    //     "command": "npx",
    //     "args": ["-y", "@azure-devops/mcp-server"],
    //     "envFile": "${workspaceFolder}/.env"
    //   }
  },
  "inputs": []
}